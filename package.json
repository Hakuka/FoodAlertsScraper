{
  "name": "foodalertsscraper",
  "version": "1.0.0",
  "description": "Scraper for public food safety alerts from GIS and RASFF using Playwright and TypeScript.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/main.js",
    "docker:build": "docker build -t food-alerts-scraper:1.0 .",
    "docker:export": "docker save -o food-alerts-scraper.tar food-alerts-scraper:1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hakuka/FoodAlertsScraper.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Hakuka/FoodAlertsScraper/issues"
  },
  "homepage": "https://github.com/Hakuka/FoodAlertsScraper#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.60.0"
  }
}
